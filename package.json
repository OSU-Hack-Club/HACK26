    "data:risk": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/data/build-risk-features.mjs",
    "data:export": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/data/export-premises.mjs",
