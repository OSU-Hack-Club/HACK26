# ---------------------------------------------------------------------------
# HACK26 — AI Outage Concierge
# Copy this file to `.env.local` and fill in the values you need.
#   cp .env.example .env.local
# Everything is optional until a feature needs it; see src/env.ts.
# NEVER commit real keys. Only `NEXT_PUBLIC_*` vars are exposed to the browser.
# ---------------------------------------------------------------------------

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI / LLM (server-only) --------------------------------------------------
ANTHROPIC_API_KEY=
# Default model for the concierge assistant
AI_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=

# --- Maps (browser) -----------------------------------------------------------
# Mapbox public token (pk.*) if we use Mapbox GL / react-map-gl.
# Leave empty if we go with MapLibre + free tiles.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Weather / storm data (server-only) ---------------------------------------
# api.weather.gov (NWS) needs no key, just a descriptive User-Agent.
NWS_USER_AGENT="HACK26 Outage Concierge (team@example.com)"
OPENWEATHER_API_KEY=

# --- Challenge data -----------------------------------------------------------
# Where the extracted AEP shapefiles live (see AEP-Challenge-Materials/data/README.md)
DATA_DIR=./AEP-Challenge-Materials/data/extracted

# --- Database (optional) ------------------------------------------------------
DATABASE_URL=
