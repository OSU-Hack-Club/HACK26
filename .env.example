# ---------------------------------------------------------------------------
# HACK26 — AI Outage Concierge
# Copy this file to `.env.local` and fill in the values you need.
#   cp .env.example .env.local
# Everything is optional until a feature needs it; see src/env.ts.
# NEVER commit real keys. Only `NEXT_PUBLIC_*` vars are exposed to the browser.
# ---------------------------------------------------------------------------

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI / LLM (server-only) --------------------------------------------------
# Which backend answers free-text concierge questions.
#   auto      → pick the first configured option: anthropic → openai → local ollama
#   anthropic → hosted Claude  (needs ANTHROPIC_API_KEY)
#   openai    → hosted OpenAI  (needs OPENAI_API_KEY)
#   ollama    → local Ollama server on your desktop (no key, any pulled model)
#   off       → no AI: the concierge answers only its built-in questions
# With auto and nothing configured (or a named provider missing its key), AI is off too.
AI_PROVIDER=auto

# Model for the hosted API providers (anthropic/openai).
AI_MODEL=claude-sonnet-5-5

# Hosted provider keys (leave blank to skip that provider).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Point at an OpenAI-compatible gateway if you're not using api.openai.com.
OPENAI_BASE_URL=https://api.openai.com/v1

# Local Ollama (https://ollama.com). Start it with `ollama serve`, then
# `ollama pull llama3.1` (or any model). The concierge uses its OpenAI-compatible API.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# --- Maps (browser) -----------------------------------------------------------
# Mapbox public token (pk.*) if we use Mapbox GL / react-map-gl.
# Leave empty if we go with MapLibre + free tiles.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Weather / storm data (server-only) ---------------------------------------
# api.weather.gov (NWS) needs no key, just a descriptive User-Agent.
NWS_USER_AGENT="HACK26 Outage Concierge (team@example.com)"
OPENWEATHER_API_KEY=

# --- Challenge data -----------------------------------------------------------
# Where the extracted AEP shapefiles live (see AEP-Challenge-Materials/data/README.md)
DATA_DIR=./AEP-Challenge-Materials/data/extracted

# --- Database (optional) ------------------------------------------------------
DATABASE_URL=

# --- DynamoDB premise lookup (optional, server-only) --------------------------
# When set, /api/premise looks real premises up in DynamoDB; otherwise the app
# uses the static demo premises in src/data/risk-features.json.
# See scripts/data/{export-premises,load-dynamo}.mjs and DEVELOPMENT.md.
DYNAMODB_TABLE=
AWS_REGION=us-east-2
# Keyed hash for premise IDs. Must match the secret used when exporting (npm run data:export),
# and be the same for every teammate using the shared table. Share it privately; never commit it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PREMISE_HASH_SECRET=
# Local only: AWS CLI profile the scripts and the server use for credentials (not validated by env.ts).
# AWS_PROFILE=sandbox
